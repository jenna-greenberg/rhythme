{
  "name": "weekly-planner",
  "version": "1.0.0",
  "description": "A comprehensive weekly planner with drag-and-drop scheduling, multi-schedule overlays, and ADHD-friendly todo management",
  "private": true,
  "homepage": ".",
  "type": "module",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.263.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "vite": "^4.4.5",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "test": "echo \"No tests specified yet\" && exit 0",
    "analyze": "npm run build && npx vite-bundle-analyzer dist/assets/*.js",
    "clean": "rm -rf dist node_modules",
    "reinstall": "npm run clean && npm install"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "react",
    "planner",
    "calendar",
    "todo",
    "productivity",
    "adhd",
    "scheduling",
    "drag-and-drop",
    "weekly-planner",
    "time-management"
  ],
  "author": {
    "name": "Weekly Planner Team"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jenna-greenberg/rhythme.git"
  },
  "bugs": {
    "url": "https://github.com/jenna-greenberg/rhythme.git/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist",
    "public",
    "src",
    "index.html",
    "vite.config.js",
    "README.md"
  ]
}